Prepare feedback data:

const sentData = $('Extract Sent Email').item.json;
const findDraftResult = $input.item.json;

const sentEmail = sentData.sent_email;
const user_id = sentData.user_id;

// Check if draft was found
let originalDraft = {
  subject: '',
  body: ''
};
let incomingEmailId = '';

if (findDraftResult.found && findDraftResult.draft) {
  // Use found draft
  originalDraft = findDraftResult.draft.draft || findDraftResult.draft.original_draft || {};
  incomingEmailId = findDraftResult.draft.incoming_email_id || '';
  console.log('✅ Using found draft:', findDraftResult.draft.draft_id);
} else {
  // No draft found - this email might not have been AI-generated
  // We'll still store it as feedback (user's preferred style)
  console.log('⚠️ No matching draft found - storing sent email as feedback');
}

return [{
  json: {
    original_draft: {
      subject: originalDraft.subject || sentEmail.subject,
      body: originalDraft.body || ''
    },
    edited_version: {
      subject: sentEmail.subject,
      body: sentEmail.body
    },
    incoming_email_id: incomingEmailId,
    user_id: user_id
  }
}];




Prepare Update Feedback::

const data = $input.item.json;

// Build the API payload with actual values
const payload = {
  original_draft: {
    subject: data.original_draft?.subject || '',
    body: data.original_draft?.body || ''
  },
  edited_version: {
    subject: data.edited_version?.subject || '',
    body: data.edited_version?.body || ''
  },
  incoming_email_id: data.incoming_email_id || '',
  user_id: data.user_id 
};

// Log for debugging
console.log('Prepared update payload:', JSON.stringify(payload, null, 2));

return [{
  json: payload
}];