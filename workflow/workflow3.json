Extract send emails

const email = $input.item.json;

// Extract sent email data
const sentEmail = {
  id: email.id,
  subject: email.subject || '',
  body: email.body?.content || email.bodyPreview || '',
  to: email.toRecipients?.[0]?.emailAddress?.address || 
      (email.toRecipients && email.toRecipients.length > 0
        ? email.toRecipients.map(r => r.emailAddress?.address).join(', ')
        : ''),
  sentDateTime: email.sentDateTime || email.receivedDateTime || '',
  bodyPreview: email.bodyPreview || '',
  from: email.from?.emailAddress?.address ||
        email.sender?.emailAddress?.address ||
        email.from || ''
};

// Clean HTML from body
let bodyText = sentEmail.body;
if (bodyText && bodyText.includes('<')) {
  bodyText = bodyText.replace(/<[^>]*>/g, '');
  bodyText = bodyText.replace(/&nbsp;/g, ' ')
                     .replace(/&amp;/g, '&')
                     .replace(/&lt;/g, '<')
                     .replace(/&gt;/g, '>')
                     .replace(/&quot;/g, '"');
}

// Extract a dynamic user ID (sender of the sent email)
const userId = sentEmail.from || "unknown_user";

return [{
  json: {
    sent_email: {
      ...sentEmail,
      body: bodyText || sentEmail.bodyPreview || ''
    },
    user_id: userId
  }
}];



